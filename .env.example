# The server reads DATABASE_PATH, APP_ENV, and ENABLE_DEMO_AUTH from its process.
# It does not load .env automatically. Remaining LLM/limit settings are planned.
# Add credentials only to ignored local configuration or secure host settings.
# Provider, model, and verified pricing must be selected before paid validation.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
DATABASE_PATH=./data/customer_service.sqlite3
TASK_BUDGET_USD=0.05
MAX_TURNS=8
MAX_TASK_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
# Development fixtures must never be enabled for public deployment.
APP_ENV=development
ENABLE_DEMO_AUTH=false
# Session capabilities are generated in memory by the trusted demo launcher;
# never copy CS_SESSION_TOKEN or security references into this file.
