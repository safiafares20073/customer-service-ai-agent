# Process environment template; neither command automatically loads .env.
# Add credentials only to ignored local configuration or secure host settings.
# OPENAI_API_KEY is also accepted; never add a real value to this example.
LLM_API_KEY=
OPENAI_MODEL=gpt-6-luna
MODEL_PRICING_FILE=config/model_pricing.json
DATABASE_PATH=./data/customer_service.sqlite3
# Fixed upper limits: 8 requests, USD 0.05 estimated, 60s active, 10s/tool.
# Environment variables cannot raise these limits. No paid calls by default.
# Development fixtures must never be enabled for public deployment.
APP_ENV=development
ENABLE_DEMO_AUTH=false
# Session capabilities are generated in memory by a trusted synthetic launcher;
# never copy CS_SESSION_TOKEN or security references into this file.

# Hosted deployment uses the dedicated container, not the development launcher.
# This template grants no reviewers and authorizes no paid calls.
# Configure production values privately in Render secret settings; see docs/DEPLOYMENT.md.
HOSTED_DATA_DIR=/var/lib/customer-service
HOSTED_ORIGIN=
OIDC_ISSUER=
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
HOSTED_COOKIE_SECRET=
HOSTED_PRINCIPAL_SECRET=
HOSTED_REVIEWERS_JSON=[]
HOSTED_SESSION_SECONDS=900
HOSTED_TASKS_PER_HOUR=5
HOSTED_PAID_ENABLED=false
HOSTED_GLOBAL_BUDGET_USD=0
HOSTED_PRINCIPAL_BUDGET_USD=0
HOSTED_APPROVAL_UNTIL=0
